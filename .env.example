# Salin file ini menjadi .env lalu isi sesuai MySQL di laptopmu.
# Jangan commit file .env.

NODE_ENV=development
PORT=5000

# Origin frontend yang boleh memanggil API, pisahkan dengan koma.
CORS_ORIGIN=http://localhost:5173
# Alamat frontend untuk tautan di email (reset kata sandi). Kosong = origin pertama CORS_ORIGIN.
FRONTEND_URL=http://localhost:5173
# Umur tautan reset kata sandi.
RESET_TOKEN_EXPIRES_IN=30m

# Email keluar lewat SMTP (tautan reset kata sandi). Cara memakai Gmail:
#   1. Pakai akun Gmail khusus proyek, bukan email pribadi.
#   2. Aktifkan Verifikasi 2 Langkah di akun itu.
#   3. Google Account > Security > App passwords: buat App Password (kode 16 karakter).
#   4. Isi SMTP_USER dengan alamat Gmail itu dan SMTP_PASS dengan App Password-nya,
#      mis. MAIL_FROM="Difabel Jabar Connect <alamat@gmail.com>". Restart backend.
# Jika SMTP_HOST/SMTP_USER/SMTP_PASS kosong, tautan reset hanya ditulis ke terminal backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# MySQL 8 lokal (development). Di Railway, isi dengan variabel MYSQLHOST, MYSQLPORT, dst.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=djc
DB_PASSWORD=ganti_password_ini
DB_NAME=difabel_jabar_connect
DB_CONNECTION_LIMIT=10

# Auth (dipakai mulai fitur login). Isi JWT_SECRET dengan string acak panjang, mis. hasil:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Wajib diisi di production. Di development, jika kosong server memakai secret acak
# sementara (semua sesi hilang setiap server restart).
JWT_SECRET=
# Umur sesi login biasa (24 jam, NFR-SEC-02) dan sesi "Ingat saya".
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Login dengan Google (GET /api/v1/auth/google). Jika client ID atau secret kosong, tombol
# Google dikembalikan ke halaman Masuk dengan ?google_error=unavailable. Cara membuat:
#   1. Buka console.cloud.google.com, buat atau pilih project.
#   2. APIs & Services > OAuth consent screen: pilih External, status Testing,
#      tambahkan Gmail sendiri (dan anggota tim) sebagai Test users.
#   3. APIs & Services > Credentials > Create credentials > OAuth client ID, tipe Web application.
#   4. Authorized redirect URIs: http://localhost:5000/api/v1/auth/google/callback
#      (tambahkan URL Railway saat deploy, lalu isi GOOGLE_REDIRECT_URI dengan URL itu).
#   5. Salin Client ID dan Client secret ke bawah. Jangan commit secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kosong = http://localhost:<PORT>/api/v1/auth/google/callback. Harus sama persis dengan
# Authorized redirect URI di Google Cloud.
GOOGLE_REDIRECT_URI=

# Seeder data dummy (npm run db:seed). Password semua akun demo, default Demo12345.
SEED_PASSWORD=
# Wajib 1 jika menjalankan seeder di NODE_ENV=production (seeder menghapus semua data).
SEED_FORCE=
