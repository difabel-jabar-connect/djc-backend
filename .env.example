# Salin file ini menjadi .env lalu isi sesuai MySQL di laptopmu.
# Jangan commit file .env.

NODE_ENV=development
PORT=5000

# Origin frontend yang boleh memanggil API, pisahkan dengan koma.
CORS_ORIGIN=http://localhost:5173

# MySQL 8 lokal (development). Di Railway, isi dengan variabel MYSQLHOST, MYSQLPORT, dst.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=djc
DB_PASSWORD=ganti_password_ini
DB_NAME=difabel_jabar_connect
DB_CONNECTION_LIMIT=10

# Auth (dipakai mulai fitur login). Isi JWT_SECRET dengan string acak panjang, mis. hasil:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Seeder data dummy (npm run db:seed). Password semua akun demo, default Demo12345.
SEED_PASSWORD=
# Wajib 1 jika menjalankan seeder di NODE_ENV=production (seeder menghapus semua data).
SEED_FORCE=
